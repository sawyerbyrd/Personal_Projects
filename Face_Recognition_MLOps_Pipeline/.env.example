# Copy to .env and adjust. All paths are relative to the process working directory unless absolute.

# ── Storage ─────────────────────────────────────────────────────────────────
# Local (default for demo):
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
PREPROCESSED_DIR=preprocessed
MODEL_DIR=models/latest
MLRUNS_DIR=mlruns

# S3 (uncomment + fill in to switch to AWS):
# STORAGE_BACKEND=s3
# S3_BUCKET=my-bucket-name
# S3_PREFIX=face-recognition        # optional key prefix
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=                  # leave empty for real AWS; set for LocalStack/MinIO
# AWS credentials are read from the standard boto3 chain (env vars, ~/.aws/credentials, IAM role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Service URLs ─────────────────────────────────────────────────────────────
PREPROCESS_BASE_URL=http://localhost:8001
RETRAIN_BASE_URL=http://localhost:8002
INFERENCE_BASE_URL=http://localhost:8003
PREPROCESS_TRIGGER_RETRAIN=true
RETRAIN_NOTIFY_INFERENCE=true

# ── MLflow ───────────────────────────────────────────────────────────────────
# Leave empty to use file:{STORAGE_ROOT}/{MLRUNS_DIR} (local fallback).
# docker-compose sets this to http://mlflow:5000 automatically.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=face_recognition_lfw
MLFLOW_MODEL_NAME=face_recognition_model
